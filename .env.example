# ==============================================================================
# ADMISSION BY CHOICE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Production Deployment Architecture:
# - Frontend: Deployed on Vercel
# - Backend: Deployed as a Render Web Service
# - Database: PostgreSQL (Managed database on Render, Supabase, Neon, or AWS RDS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel Project Settings)
# ------------------------------------------------------------------------------
# Development: http://localhost:5001/api
# Production (Required on Vercel): Set to your deployed Render backend API URL
# Example: https://admission-by-choice-backend.onrender.com/api
VITE_API_URL=http://localhost:5001/api

# Google OAuth Client ID for Student Sign-In (Safe for public client exposure)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render Web Service Environment Tab)
# ------------------------------------------------------------------------------
# Note on PORT: Render automatically assigns and injects the PORT environment variable.
# In local development, the backend defaults to 5001.
NODE_ENV=production
FRONTEND_URL=https://your-counselling-frontend.vercel.app

# PostgreSQL Database Connection URL (Prisma ORM)
# Example: postgresql://user:password@dpg-xxxxx.render.com/counselling_db?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/counselling_db?schema=public

# JWT Authentication Secret Key (Required for signing student & admin session tokens)
JWT_SECRET=generate-a-secure-random-32-byte-hex-string-for-jwt-signing

# ------------------------------------------------------------------------------
# 3. PRODUCTION ADMIN CREDENTIALS & SECURITY
# ------------------------------------------------------------------------------
# Email address of the primary administrative authority
ADMIN_EMAIL=admissionbychoice@gmail.com

# Secure Bcrypt Password Hash for Admin Login (DO NOT STORE PLAINTEXT PASSWORDS)
# Generate using: node -e "console.log(require('bcryptjs').hashSync('YourSecurePassword', 10))"
ADMIN_PASSWORD_HASH=$2a$10$YourBcryptPasswordHashHere

# ------------------------------------------------------------------------------
# 4. AI COLLEGE ADVISOR (Google Gemini / OpenAI)
# ------------------------------------------------------------------------------
AI_API_KEY=your-gemini-or-openai-api-key-here

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH BACKEND CREDENTIALS
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ------------------------------------------------------------------------------
# 6. EMAIL NOTIFICATIONS FOR NEW ENQUIRIES (Nodemailer / SMTP)
# ------------------------------------------------------------------------------
# If omitted, enquiries are safely saved in PostgreSQL and viewable in Admin Dashboard
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=admissionbychoice@gmail.com
EMAIL_PASS=your-gmail-app-password-or-smtp-key
ADMIN_NOTIFICATION_EMAIL=admissionbychoice@gmail.com

# ------------------------------------------------------------------------------
# 7. GOOGLE SHEETS ENQUIRY SYNCHRONIZATION (Optional Reporting)
# ------------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheets-spreadsheet-id
