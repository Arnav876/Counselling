generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model College {
  id                  String           @id @default(uuid())
  code                String           @unique
  name                String
  shortName           String
  slug                String           @unique
  logo                String
  image               String
  city                String
  state               String
  distance            Float            @default(25)
  management          String           @default("Government")
  deemedStatus        String?
  managementTypes     String[]         @default(["General Management"])
  rating              Float            @default(4.5)
  reviewsCount        Int              @default(120)
  nirfRank            Int?
  estYear             Int              @default(2000)
  accreditation       String           @default("NMC Recognized")
  shortDescription    String
  fullDescription     String
  highlights          String[]         @default([])
  stream              String           @default("Medical")
  address             String
  phone               String           @default("+91 11 2658 8500")
  email               String           @default("admissions@nmc.org.in")
  website             String           @default("https://www.nmc.org.in")
  campusArea          String?          @default("50+ Acres")
  studentFacultyRatio String?          @default("1:2.5")
  mbbsSeats           Int              @default(0)
  pgSeats             Int              @default(0)
  pgCoursesSummary    String?
  
  courses             Course[]
  facilities          Facility[]
  admissionInfo       AdmissionInfo?
  gallery             CollegeGallery[]
  packageStats        PackageStats?
  savedBy             SavedCollege[]

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([state])
  @@index([management])
  @@index([stream])
  @@index([slug])
}

model Course {
  id          String   @id @default(uuid())
  collegeId   String
  name        String
  degree      String
  duration    String
  annualFee   String
  seats       Int
  eligibility String

  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

model Facility {
  id          String   @id @default(uuid())
  collegeId   String
  name        String
  iconName    String
  description String?

  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

model AdmissionInfo {
  id                     String   @id @default(uuid())
  collegeId              String   @unique
  process                String
  entranceExams          String[] @default(["NEET-UG", "NEET-PG"])
  cutoffPercentile       String   @default("95+ Percentile")
  applicationDeadline    String   @default("August 31, 2026")
  eligibilityCriteria    String
  managementQuotaDetails String?

  college                College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model PackageStats {
  id            String   @id @default(uuid())
  collegeId     String   @unique
  average       String   @default("₹12-18 LPA")
  highest       String   @default("₹35+ LPA")
  topRecruiters String[] @default(["AIIMS", "Apollo Hospitals", "Fortis Healthcare", "Max Healthcare", "Medanta"])

  college       College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model CollegeGallery {
  id        String  @id @default(uuid())
  collegeId String
  url       String
  caption   String?

  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

model StateSummary {
  id             String   @id @default(uuid())
  name           String   @unique
  code           String
  collegeCount   Int      @default(0)
  totalMbbsSeats Int      @default(0)
  totalPgSeats   Int      @default(0)
  image          String
  popularCities  String[] @default([])
}

model User {
  id            String         @id @default(uuid())
  googleId      String?        @unique
  email         String         @unique
  passwordHash  String?
  name          String
  avatar        String?
  role          String         @default("STUDENT") // STUDENT, ADMIN, SUPER_ADMIN
  status        String         @default("ACTIVE")  // ACTIVE, SUSPENDED
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastLoginAt   DateTime       @default(now())

  savedColleges SavedCollege[]
  conversations Conversation[]
  enquiries     Enquiry[]
  contacts      Contact[]

  @@index([email])
  @@index([role])
}

model AuthorizedAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  role      String   @default("ADMIN") // ADMIN, SUPER_ADMIN
  addedBy   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model SavedCollege {
  id        String   @id @default(uuid())
  userId    String
  collegeId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
  @@index([userId])
  @@index([collegeId])
}

model Conversation {
  id        String        @id @default(uuid())
  userId    String
  title     String        @default("College Advisory Chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  role           String       // USER, ASSISTANT
  content        String
  colleges       Json?
  suggestions    String[]     @default([])
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Enquiry {
  id              String   @id @default(uuid())
  userId          String?
  collegeName     String
  studentName     String
  email           String?
  phone           String
  preferredCourse String
  preferredState  String?
  notes           String?
  adminNote       String?
  status          String   @default("NEW") // NEW, IN_PROGRESS, CONTACTED, RESOLVED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model Contact {
  id             String   @id @default(uuid())
  userId         String?
  fullName       String
  email          String
  phone          String
  subject        String
  message        String
  preferredState String?
  adminNote      String?
  status         String   @default("NEW") // NEW, IN_PROGRESS, CONTACTED, RESOLVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model Blog {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  coverImage  String    @default("https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=1200&auto=format&fit=crop&q=80")
  category    String    // PRIVATE, GOVERNMENT
  author      String    @default("Admission by Choice Advisory")
  status      String    @default("DRAFT") // DRAFT, PUBLISHED
  tags        String[]  @default([])
  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([category])
  @@index([status])
}
